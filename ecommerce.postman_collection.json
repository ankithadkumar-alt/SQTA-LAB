{
  "info": {
    "name": "E-Commerce SUT Test Suite",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Reset Cart State",
      "request": {
        "method": "POST",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/cart/reset", "host": ["{{baseUrl}}"], "path": ["api", "cart", "reset"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('Status code is 200', () => pm.response.to.have.status(200));"],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. TC-AUTH-01: Valid Login & Token Chaining",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"student@test.com\",\n  \"password\": \"Password123\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Response contains Bearer token', () => {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('token');",
              "    pm.environment.set('authToken', json.token);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. TC-AUTH-02: Missing Password (Negative)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"student@test.com\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 400 Bad Request', () => pm.response.to.have.status(400));",
              "pm.test('Error message received', () => {",
              "    pm.expect(pm.response.json().error).to.include('password are required');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. TC-CART-02: Boundary Zero Quantity (BVA)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": 1,\n  \"quantity\": 0\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/cart/add", "host": ["{{baseUrl}}"], "path": ["api", "cart", "add"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('Status code is 422 Unprocessable Entity', () => pm.response.to.have.status(422));"],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "5. TC-CART-04: Exceed Stock Limit (Boundary)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": 2,\n  \"quantity\": 9999\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/cart/add", "host": ["{{baseUrl}}"], "path": ["api", "cart", "add"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 409 Conflict', () => pm.response.to.have.status(409));",
              "pm.test('Error message cites stock limit', () => {",
              "    pm.expect(pm.response.json().error).to.include('Insufficient stock');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "6. TC-CART-01: Valid Add to Cart",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": 1,\n  \"quantity\": 2\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/cart/add", "host": ["{{baseUrl}}"], "path": ["api", "cart", "add"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('Status code is 200 OK', () => pm.response.to.have.status(200));"],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "7. TC-DISC-01: Apply 20% Coupon",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"SAVE20\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/cart/coupon", "host": ["{{baseUrl}}"], "path": ["api", "cart", "coupon"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('Status code is 200 OK', () => pm.response.to.have.status(200));"],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "8. TC-CALC-01: Mathematical Calculation Verification",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/cart", "host": ["{{baseUrl}}"], "path": ["api", "cart"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "pm.test('Mathematical accuracy: (Subtotal - Discount) + Tax === Total', () => {",
              "    const d = pm.response.json();",
              "    const calculated = Number(((d.subtotal - d.discount) + d.tax).toFixed(2));",
              "    pm.expect(d.total).to.eql(calculated);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "9. TC-CHK-02: Checkout Unauthorized (Security)",
      "request": {
        "method": "POST",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/checkout", "host": ["{{baseUrl}}"], "path": ["api", "checkout"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": ["pm.test('Status code is 401 Unauthorized', () => pm.response.to.have.status(401));"],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "10. TC-CHK-03: Checkout Authorized (End-to-End)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/checkout", "host": ["{{baseUrl}}"], "path": ["api", "checkout"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 Created', () => pm.response.to.have.status(201));",
              "pm.test('Response Time is under 300ms SLA', () => {",
              "    pm.expect(pm.response.responseTime).to.be.below(300);",
              "});",
              "pm.test('Schema validation: order object is correct', () => {",
              "    const json = pm.response.json();",
              "    pm.expect(json.order).to.have.property('orderId');",
              "    pm.expect(json.order.status).to.eql('CONFIRMED');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}